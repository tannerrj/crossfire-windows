# Generated NSIS installer script (written to $HOME by build.sh)
crossfire-installer.nsi

# Built installers
CrossfireServer-*-Setup.exe

# Compiled build artifacts (produced in $SRCDIR and /tmp, not in this repo,
# but ignored here as a safety net if build.sh is run from within the repo)
*.dll
*.dll.a
*.exe
*.o
*.lo
*.la
*.a

# Python byte-compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Staging directory (if accidentally created inside the repo)
crossfire-staging/

# Temporary files
*.tmp
*.bak

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
